# Connexion à moodleDb sur Neon — ENDPOINT DIRECT obligatoire (host SANS
# "-pooler"), même précaution que documentée pour isseg/isseg_test : le
# pooler PgBouncer casse les connexions applicatives persistantes que
# Moodle ouvre au démarrage. Voir SETUP.md pour comment récupérer ce host.
MOODLE_DB_HOST=ep-xxxxxxxx.c-2.eu-west-2.aws.neon.tech
MOODLE_DB_PORT=5432
MOODLE_DB_NAME=moodleDb
MOODLE_DB_USER=CHANGE_ME
MOODLE_DB_PASSWORD=CHANGE_ME

# URL COMPLÈTE du site (schéma + port inclus) — utilisée telle quelle comme
# $CFG->wwwroot dans config.php, doit correspondre à MOODLE_APP_PORT
# ci-dessous pour un usage local.
MOODLE_SITE_URL=http://localhost:8090

# Port d'exposition local du conteneur (doit correspondre au port dans
# MOODLE_SITE_URL ci-dessus).
MOODLE_APP_PORT=8090

# Répertoire local où cloner le code source Moodle (voir SETUP.md) — monté
# comme docroot Apache. Chemin relatif à ce dossier (services/moodle-service
# /moodle-app/), jamais commité (voir .gitignore).
MOODLE_SRC_DIR=./moodle-src

# Compte administrateur — créé via admin/cli/install_database.php lors de
# l'installation (voir SETUP.md), ces variables ne servent qu'à cette étape.
MOODLE_ADMIN_USERNAME=CHANGE_ME
MOODLE_ADMIN_PASSWORD=CHANGE_ME
MOODLE_ADMIN_EMAIL=CHANGE_ME@isseg.local
