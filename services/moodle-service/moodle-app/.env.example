# Connexion à moodleDb sur Neon — ENDPOINT DIRECT obligatoire (host SANS
# "-pooler"), même précaution que documentée pour isseg/isseg_test : le
# pooler PgBouncer casse les connexions applicatives persistantes que
# Moodle ouvre au démarrage. Voir SETUP.md pour comment récupérer ce host.
MOODLE_DB_HOST=ep-xxxxxxxx.c-2.eu-west-2.aws.neon.tech
MOODLE_DB_PORT=5432
MOODLE_DB_NAME=moodleDb
MOODLE_DB_USER=CHANGE_ME
MOODLE_DB_PASSWORD=CHANGE_ME

# URL publique du site (sans schéma pour un usage local ; ex. localhost,
# ou le nom de domaine réel en production).
MOODLE_SITE_URL=localhost

# Port d'exposition local du conteneur (http://localhost:<port>).
MOODLE_APP_PORT=8090

# Compte administrateur créé au premier démarrage (bootstrap uniquement —
# voir SETUP.md, ces variables ne servent qu'à l'installation initiale).
MOODLE_ADMIN_USERNAME=CHANGE_ME
MOODLE_ADMIN_PASSWORD=CHANGE_ME
MOODLE_ADMIN_EMAIL=CHANGE_ME@isseg.local
