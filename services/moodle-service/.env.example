# Port d'écoute du service (distinct de apps/api, qui utilise 3001 par défaut)
PORT=3003
NODE_ENV=development

# Connexion à l'instance Moodle — infrastructure pure, pas encore de
# mapping de données (attend les entretiens Moodle).
MOODLE_BASE_URL=https://moodle.example.org
MOODLE_API_KEY=CHANGE_ME
