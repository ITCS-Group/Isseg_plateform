# Environment
NODE_ENV=development
PORT=3001

# Base de données PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/isseg?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS (URL du frontend)
CORS_ORIGIN=http://localhost:3000

# JWT — utiliser au minimum 64 caractères aléatoires en production
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_IN_PRODUCTION
JWT_REFRESH_EXPIRES_IN=7d

# Cookie pour le refresh token
COOKIE_NAME=refreshToken

# Admin initial (seed)
ADMIN_EMAIL=admin@isseg.local
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_NOM=Administrateur
ADMIN_PRENOM=Système

# Bibliothèque — types d'Abonne (TypeAbonne Prisma) autorisés à emprunter à
# domicile. Valeur par défaut : ENSEIGNANT uniquement (décision métier du
# 05/08/2026 — les étudiants sont limités à la consultation sur place au
# lancement). Pour réactiver l'accès étudiant : ajouter ETUDIANT_L1_L2 et/ou
# ETUDIANT_L3_M2, séparés par des virgules, sans redéploiement de code.
BIBLIOTHEQUE_EMPRUNT_DOMICILE_TYPES_AUTORISES=ENSEIGNANT
