# Configuration partagée des éditeurs pour le monorepo ISSEG.
# Objectif principal : empêcher la réintroduction d'un BOM UTF-8, que Git seul
# ne sait ni détecter ni retirer. Le parseur JSON de Turbo (Rust) refuse le BOM
# et bloque tout le workspace, contrairement à pnpm qui le retire silencieusement.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
