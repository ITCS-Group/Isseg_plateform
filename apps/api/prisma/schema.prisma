datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum StatutPaiement {
  EN_ATTENTE
  PARTIEL
  PAYE
}

enum StatutTransaction {
  INITIEE
  COMPLETEE
  ECHOUEE
  ANNULEE
}

enum StatutDossier {
  BROUILLON
  SOUMIS
  EN_TRAITEMENT
  INSCRIT
  REJETE
}

enum DecisionScolarite {
  EN_ATTENTE
  ADMIS
  REFUSE
  LISTE_D_ATTENTE
}

enum StatutValidation {
  EN_ATTENTE
  APPROUVE
  REJETE
  A_REVISER
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  TOKEN_REFRESHED
  TOKEN_REVOKED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  PASSWORD_CHANGED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

// ----------------------------------------------------
// 1. IDENTITÉ ET UTILISATEURS
// ----------------------------------------------------

model Utilisateur {
  id             String    @id @default(uuid())
  nom            String
  prenom         String
  email          String    @unique
  motDePasseHash String
  estActif       Boolean   @default(true)
  loginAttempts  Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles         UtilisateurRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  etudiant      Etudiant?
  personnel     Personnel?
  parent        Parent?

  dossiersValides         DossierInscription[]  @relation("DossierValidateur")
  registrationHistory     RegistrationHistory[] @relation("HistoryAuthor")
  noteEtudiantHistoriques NoteEtudiantHistory[] @relation("NoteHistoryAuthor")

  emprunts Emprunt[]
  abonne   Abonne?
}

model Role {
  id      String @id @default(uuid())
  nomRole String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  utilisateurs UtilisateurRole[]
  permissions  RolePermission[]
}

model Permission {
  id            String  @id @default(uuid())
  nomPermission String  @unique
  description   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]
}

model UtilisateurRole {
  utilisateurId String
  roleId        String

  createdAt DateTime @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])
  role        Role        @relation(fields: [roleId], references: [id])

  @@id([utilisateurId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  createdAt DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model RefreshToken {
  id            String   @id @default(uuid())
  tokenHash     String   @unique
  utilisateurId String
  expiresAt     DateTime
  isRevoked     Boolean  @default(false)
  createdAt     DateTime @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
}

model AuditLog {
  id            String      @id @default(uuid())
  utilisateurId String?
  action        AuditAction
  ipAddress     String?
  userAgent     String?
  details       Json?
  createdAt     DateTime    @default(now())

  utilisateur Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  @@index([utilisateurId, action, createdAt])
}

// ----------------------------------------------------
// 2. PERSONNEL ET STRUCTURE
// ----------------------------------------------------

model Personnel {
  id           String   @id @default(uuid())
  userId       String   @unique
  matricule    String   @unique
  poste        String
  dateEmbauche DateTime
  salaire      Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  utilisateur Utilisateur @relation(fields: [userId], references: [id])

  departementId String?
  departement   Departement? @relation("PersonnelDepartement", fields: [departementId], references: [id])

  departementDirige Departement? @relation("DepartementDirecteur")

  fraisEnregistres FraisScolarite[] @relation("FraisEnregistreur")

  enseignant  Enseignant?
  responsable ResponsablePedagogique?
}

model Departement {
  id          String @id @default(uuid())
  code        String @unique
  nom         String
  description String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  directeurId String?    @unique
  directeur   Personnel? @relation("DepartementDirecteur", fields: [directeurId], references: [id])

  personnels Personnel[] @relation("PersonnelDepartement")
  filieres   Filiere[]
}

// ----------------------------------------------------
// 3. ÉTUDIANTS, SCOLARITÉ ET PARAMÉTRAGE
// ----------------------------------------------------

model AnneeUniversitaire {
  id        String   @id @default(uuid())
  libelle   String   @unique
  dateDebut DateTime
  dateFin   DateTime
  estActive Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inscriptions        Inscription[]
  fraisScolarite      FraisScolarite[]
  dossiersInscription DossierInscription[]
}

model Filiere {
  id            String  @id @default(uuid())
  code          String  @unique
  nom           String
  description   String?
  departementId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departement Departement? @relation(fields: [departementId], references: [id])
  classes     Classe[]
}

model Etudiant {
  id              String   @id @default(uuid())
  userId          String   @unique
  matriculeUnique String?  @unique
  dateNaissance   DateTime
  telephone       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  utilisateur Utilisateur @relation(fields: [userId], references: [id])

  dossiers     DossierInscription[]
  inscriptions Inscription[]
  carnetSuivi  CarnetSuivi?

  parents Parent[] @relation("ParentEtudiant")

  documentsAcademiques DocumentAcademique[]
}

model DossierInscription {
  id                String            @id @default(uuid())
  etudiantId        String
  anneeId           String
  classeId          String
  documentsFournis  String[]
  decisionScolarite DecisionScolarite @default(EN_ATTENTE)
  statutDossier     StatutDossier     @default(BROUILLON)
  version           Int               @default(1)
  dateSoumission    DateTime?
  dateValidation    DateTime?
  validePar         String?
  motifRejet        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  etudiant           Etudiant              @relation(fields: [etudiantId], references: [id])
  anneeUniversitaire AnneeUniversitaire    @relation(fields: [anneeId], references: [id])
  classe             Classe                @relation(fields: [classeId], references: [id])
  validateur         Utilisateur?          @relation("DossierValidateur", fields: [validePar], references: [id])
  history            RegistrationHistory[]

  @@unique([etudiantId, anneeId])
}

model RegistrationHistory {
  id         String         @id @default(uuid())
  dossierId  String
  fromStatus StatutDossier?
  toStatus   StatutDossier
  changedBy  String
  changedAt  DateTime       @default(now())
  comment    String?

  dossier DossierInscription @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  author  Utilisateur        @relation("HistoryAuthor", fields: [changedBy], references: [id])

  @@index([dossierId, changedAt])
  @@index([changedBy])
}

model Classe {
  id         String @id @default(uuid())
  codeClasse String @unique
  libelle    String
  niveau     String
  filiereId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  filiere             Filiere              @relation(fields: [filiereId], references: [id])
  inscriptions        Inscription[]
  dossiersInscription DossierInscription[]
  coursScenarises     CoursClasse[]
}

model Inscription {
  id              String   @id @default(uuid())
  etudiantId      String
  classeId        String
  anneeId         String
  dateInscription DateTime @default(now())
  estActive       Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  etudiant           Etudiant           @relation(fields: [etudiantId], references: [id])
  classe             Classe             @relation(fields: [classeId], references: [id])
  anneeUniversitaire AnneeUniversitaire @relation(fields: [anneeId], references: [id])

  frais FraisScolarite?
  notes NoteEtudiant[]

  @@unique([etudiantId, anneeId])
}

// ----------------------------------------------------
// 4. FINANCE
// ----------------------------------------------------

model FraisScolarite {
  id              String         @id @default(uuid())
  inscriptionId   String         @unique
  enregistreParId String
  anneeId         String
  montantTotal    Decimal
  montantPaye     Decimal
  statutPaiement  StatutPaiement @default(EN_ATTENTE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inscription        Inscription        @relation(fields: [inscriptionId], references: [id])
  enregistrePar      Personnel          @relation("FraisEnregistreur", fields: [enregistreParId], references: [id])
  anneeUniversitaire AnneeUniversitaire @relation(fields: [anneeId], references: [id])

  transactions Transaction[]
}

model Transaction {
  id              String            @id @default(uuid())
  fraisId         String
  referenceUnique String            @unique
  montant         Decimal
  dateTransaction DateTime          @default(now())
  modePaiement    String
  statut          StatutTransaction @default(INITIEE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  frais FraisScolarite @relation(fields: [fraisId], references: [id])

  @@index([fraisId])
}

// ----------------------------------------------------
// 5. PÉDAGOGIE
// ----------------------------------------------------

model Enseignant {
  id          String @id @default(uuid())
  personnelId String @unique
  specialite  String
  grade       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  personnel Personnel @relation(fields: [personnelId], references: [id])

  coursScenarises CoursScenarise[]
  evaluations     Evaluation[]

  documentsDiriges DocumentAcademique[]
}

model ResponsablePedagogique {
  id          String @id @default(uuid())
  personnelId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  personnel Personnel @relation(fields: [personnelId], references: [id])

  validations ValidationCours[]
}

model CoursScenarise {
  id                    String           @id @default(uuid())
  enseignantId          String
  titre                 String
  codeCours             String           @unique
  description           String
  objectifsPedagogiques String
  statutValidation      StatutValidation @default(EN_ATTENTE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enseignant Enseignant @relation(fields: [enseignantId], references: [id])

  evaluations Evaluation[]
  validations ValidationCours[]
  classes     CoursClasse[]
}

/// Table de liaison N↔N : un cours peut être associé à plusieurs classes,
/// une classe peut suivre plusieurs cours. Détermine les étudiants éligibles
/// (via Classe → Inscription → Etudiant) pour la saisie de notes (PED-EVAL-01).
model CoursClasse {
  id       String @id @default(uuid())
  coursId  String
  classeId String

  createdAt DateTime @default(now())

  cours  CoursScenarise @relation(fields: [coursId], references: [id])
  classe Classe         @relation(fields: [classeId], references: [id])

  epreuves Epreuve[]

  @@unique([coursId, classeId])
}

enum TypeEpreuve {
  CC
  TP
  EXAMEN
  RATTRAPAGE
}

model Epreuve {
  id            String      @id @default(uuid())
  coursClasseId String
  type          TypeEpreuve

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coursClasse CoursClasse    @relation(fields: [coursClasseId], references: [id])
  notes       NoteEtudiant[]
}

model NoteEtudiant {
  id            String  @id @default(uuid())
  epreuveId     String
  inscriptionId String
  noteBrute     Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  epreuve     Epreuve     @relation(fields: [epreuveId], references: [id])
  inscription Inscription @relation(fields: [inscriptionId], references: [id])

  historique NoteEtudiantHistory[]

  @@unique([epreuveId, inscriptionId])
}

model NoteEtudiantHistory {
  id             String   @id @default(uuid())
  noteEtudiantId String
  ancienneValeur Decimal
  nouvelleValeur Decimal
  modifieParId   String
  motif          String?
  changedAt      DateTime @default(now())

  noteEtudiant NoteEtudiant @relation(fields: [noteEtudiantId], references: [id], onDelete: Cascade)
  modifiePar   Utilisateur  @relation("NoteHistoryAuthor", fields: [modifieParId], references: [id])

  @@index([noteEtudiantId, changedAt])
  @@index([modifieParId])
}

model ValidationCours {
  id             String           @id @default(uuid())
  coursId        String
  responsableId  String
  dateValidation DateTime         @default(now())
  statut         StatutValidation @default(EN_ATTENTE)
  commentaire    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cours       CoursScenarise         @relation(fields: [coursId], references: [id])
  responsable ResponsablePedagogique @relation(fields: [responsableId], references: [id])
}

model Evaluation {
  id            String   @id @default(uuid())
  coursId       String
  correcteurId  String
  codeAnonymat  String   @unique
  noteOriginale Decimal
  noteAjustee   Decimal?
  estAnonyme    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cours      CoursScenarise @relation(fields: [coursId], references: [id])
  correcteur Enseignant     @relation(fields: [correcteurId], references: [id])
}

// ----------------------------------------------------
// 6. PORTAIL PARENT
// ----------------------------------------------------

model Parent {
  id               String @id @default(uuid())
  userId           String @unique
  lienParente      String
  telephoneContact String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  utilisateur Utilisateur @relation(fields: [userId], references: [id])

  etudiantsCharge  Etudiant[]    @relation("ParentEtudiant")
  carnetsConsultes CarnetSuivi[] @relation("ParentCarnet")
  messages         Message[]
}

model CarnetSuivi {
  id                   String   @id @default(uuid())
  etudiantId           String   @unique
  moyenneGenerale      Decimal?
  tauxAbsences         Int      @default(0)
  appreciationGenerale String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  etudiant Etudiant @relation(fields: [etudiantId], references: [id])

  parentsSpectateurs Parent[] @relation("ParentCarnet")
}

model Message {
  id       String @id @default(uuid())
  parentId String
  objet    String
  contenu  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent Parent @relation(fields: [parentId], references: [id])
}

// ----------------------------------------------------
// 7. WORKFLOW & EVENTS
// ----------------------------------------------------

model OutboxEvent {
  id          String            @id @default(uuid())
  aggregateId String
  eventType   String
  payload     Json
  status      OutboxEventStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  processedAt DateTime?
  attempts    Int               @default(0)
  lastError   String?

  @@index([status, createdAt])
  @@index([aggregateId, eventType])
}

model ProcessedJob {
  id          String   @id @default(uuid())
  processedAt DateTime @default(now())

  @@index([processedAt])
}

// ----------------------------------------------------
// 8. BIBLIOTHÈQUE
// ----------------------------------------------------

enum StatutOuvrage {
  DISPONIBLE
  EMPRUNTE
  RESERVE
  EN_MAINTENANCE
  PERDU
}

enum StatutEmprunt {
  EN_COURS
  RETOURNE
  EN_RETARD
  PERDU
}

/// Catégorie d'abonné — détermine les règles d'emprunt (durée, quota,
/// renouvellements) selon le tableau à 4 catégories d'agent-bibliotheque.md
/// §3.1 (source de vérité, cf. CLAUDE.md § Library Loans).
enum TypeAbonne {
  ETUDIANT_L1_L2
  ETUDIANT_L3_M2
  ENSEIGNANT
  PERSONNEL_ADMIN
}

enum TypeDocumentAcademique {
  THESE
  MEMOIRE_LICENCE
  MEMOIRE_MASTER
}

enum StatutReservation {
  EN_ATTENTE
  HONOREE
  EXPIREE
  ANNULEE
}

model SectionBibliotheque {
  id          String  @id @default(uuid())
  code        String  @unique
  nom         String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ouvrages Ouvrage[]
}

model Ouvrage {
  id                     String        @id @default(uuid())
  isbn                   String?       @unique
  titre                  String
  auteur                 String
  editeur                String
  anneeEdition           Int
  cote                   String        @unique
  classificationDewey    String?
  matieres               String[]
  salle                  String
  etagere                String
  nombreExemplaires      Int           @default(1)
  exemplairesDisponibles Int           @default(1)
  statut                 StatutOuvrage @default(DISPONIBLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sectionId String
  section   SectionBibliotheque @relation(fields: [sectionId], references: [id])

  emprunts     Emprunt[]
  reservations Reservation[]
}

/// Pas de champ matricule dupliqué : l'emprunteur est un Utilisateur, et le
/// matricule (s'il existe) se retrouve via emprunteur.etudiant.matriculeUnique.
model Emprunt {
  id                      String        @id @default(uuid())
  ouvrageId               String
  emprunteurId            String
  dateEmprunt             DateTime      @default(now())
  dateRetourPrevue        DateTime
  dateRetourEffectif      DateTime?
  renouvellementsRestants Int           @default(1)
  statut                  StatutEmprunt @default(EN_COURS)
  retardJours             Int           @default(0)
  montantPenalite         Decimal       @default(0)
  penalitesPayees         Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ouvrage    Ouvrage     @relation(fields: [ouvrageId], references: [id])
  emprunteur Utilisateur @relation(fields: [emprunteurId], references: [id])

  @@index([emprunteurId])
  @@index([ouvrageId])
}

model Abonne {
  id             String     @id @default(uuid())
  utilisateurId  String     @unique
  typeAbonne     TypeAbonne
  dateDebut      DateTime   @default(now())
  dateFin        DateTime?
  statutActif    Boolean    @default(true)
  limiteEmprunts Int?
  dureePretJours Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  utilisateur  Utilisateur   @relation(fields: [utilisateurId], references: [id])
  reservations Reservation[]
}

model DocumentAcademique {
  id                    String                 @id @default(uuid())
  type                  TypeDocumentAcademique
  titre                 String
  anneeUniversitaire    String
  filiere               String
  niveau                String
  urlPdf                String
  motsCles              String[]
  resume                String
  diffusionAutorisee    Boolean                @default(false)
  embargoJusqua         DateTime?
  nombreTelechargements Int                    @default(0)
  nombreVues            Int                    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auteurId String
  auteur   Etudiant @relation(fields: [auteurId], references: [id])

  directeurMemoireId String?
  directeurMemoire   Enseignant? @relation(fields: [directeurMemoireId], references: [id])
}

model Reservation {
  id              String            @id @default(uuid())
  ouvrageId       String
  abonneId        String
  dateReservation DateTime          @default(now())
  statut          StatutReservation @default(EN_ATTENTE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ouvrage Ouvrage @relation(fields: [ouvrageId], references: [id])
  abonne  Abonne  @relation(fields: [abonneId], references: [id])

  @@index([ouvrageId])
  @@index([abonneId])
}
